 "kernaussagen": [
  {
   "typ": "Fakt",
   "dokument": "BI Thinkers Talk nr.76",
   "dokument_id": "yt:mlkP-6i5Kq8",
   "sekunde": 189,
   "zeit": "03:09",
   "url": "https://www.youtube.com/watch?v=mlkP-6i5Kq8&t=189s",
   "aussage": "In Power BI Desktop können wegen fehlender Python-Installation aus Sicherheitsgründen keine Python-basierten Visuals wie Matplotlib, Plotly oder Seaborn genutzt werden."
  },
  {
   "typ": "Fakt",
   "dokument": "Power BI Update April 2026",
   "dokument_id": "yt:fbpu8zLG3cc",
   "sekunde": 0,
   "zeit": "00:00",
   "url": "https://www.youtube.com/watch?v=fbpu8zLG3cc&t=0s",
   "aussage": "In den Canvas-Einstellungen von Power BI Desktop lässt sich jetzt Full HD als fertige Auflösungsoption auswählen."
  },
  {
   "typ": "Fakt",
   "dokument": "Power BI Update April 2026",
   "dokument_id": "yt:fbpu8zLG3cc",
   "sekunde": 25,
   "zeit": "00:25",
   "url": "https://www.youtube.com/watch?v=fbpu8zLG3cc&t=25s",
   "aussage": "Die neue Full-HD-Option ersetzt das bisher nötige manuelle Eintippen der Auflösung 1920x1080 in den Canvas-Einstellungen."
  },
  {
   "typ": "Meinung",
   "dokument": "Power BI Update April 2026",
   "dokument_id": "yt:fbpu8zLG3cc",
   "sekunde": 25,
   "zeit": "00:25",
   "url": "https://www.youtube.com/watch?v=fbpu8zLG3cc&t=25s",
   "aussage": "Der Autor sieht die feste Full-HD-Auflösung als Fortschritt, auch wenn andere Auflösungen für Browser-Bildschirme unter Umständen besser passen könnten."
  },
  {
   "typ": "Fakt",
   "dokument": "Power BI Update April 2026",
   "dokument_id": "yt:fbpu8zLG3cc",
   "sekunde": 178,
   "zeit": "02:58",
   "url": "https://www.youtube.com/watch?v=fbpu8zLG3cc&t=178s",
   "aussage": "Preview-Visuals werden in Power BI Desktop jetzt unten angepinnt angezeigt, damit sie leichter als Preview erkennbar sind."
  },
  {
   "typ": "Fakt",
   "dokument": "BI Thinkers Talk nr.75",
   "dokument_id": "yt:BQdSo6ZnmKY",
   "sekunde": 2180,
   "zeit": "36:20",
   "url": "https://www.youtube.com/watch?v=BQdSo6ZnmKY&t=2180s",
   "aussage": "Ein Perspective Editor und ein Translation Editor stehen in Power BI Desktop nativ nicht zur Verfügung und erfordern sonst Drittanbieter-Tools wie Tabular Editor."
  },
  {
   "typ": "Fakt",
   "dokument": "BI Thinkers Talk nr.75",
   "dokument_id": "yt:BQdSo6ZnmKY",
   "sekunde": 2872,
   "zeit": "47:52",
   "url": "https://www.youtube.com/watch?v=BQdSo6ZnmKY&t=2872s",
   "aussage": "Über die in der PBIR-Datei gespeicherten Seitenverbindungen lässt sich die mehrstufige Navigationsstruktur eines Berichts sichtbar machen, was in Power BI Desktop selbst nicht einsehbar ist."
  },
  {
   "typ": "Fakt",
   "dokument": "Power BI Update März 2026",
   "dokument_id": "yt:ASwcPvbMRZc",
   "sekunde": 42,
   "zeit": "00:42",
   "url": "https://www.youtube.com/watch?v=ASwcPvbMRZc&t=42s",
   "aussage": "Die visuelle Oberfläche von Power BI Desktop wurde mit neuen Standardeinstellungen modernisiert."
  },
  {
   "typ": "Meinung",
   "dokument": "Power BI Update März 2026",
   "dokument_id": "yt:ASwcPvbMRZc",
   "sekunde": 42,
   "zeit": "00:42",
   "url": "https://www.youtube.com/watch?v=ASwcPvbMRZc&t=42s",
   "aussage": "Der neue graue Standardhintergrund der visuellen Oberfläche gefällt dem Sprecher nicht."
  },
  {
   "typ": "Fakt",
   "dokument": "Power BI Update März 2026",
   "dokument_id": "yt:ASwcPvbMRZc",
   "sekunde": 96,
   "zeit": "01:36",
   "url": "https://www.youtube.com/watch?v=ASwcPvbMRZc&t=96s",
   "aussage": "Für neu angelegte Seiten ist HD die neue Standardauflösung, bestehende Seiten sind davon nicht betroffen."
  },
  {
   "typ": "Warnung",
   "dokument": "Power BI Update März 2026",
   "dokument_id": "yt:ASwcPvbMRZc",
   "sekunde": 96,
   "zeit": "01:36",
   "url": "https://www.youtube.com/watch?v=ASwcPvbMRZc&t=96s",
   "aussage": "Neue Standardeinstellungen sollten in bestehenden Produktionsberichten nur vorsichtig übernommen werden, da dort oft schon individuelle Anpassungen bestehen."
  },
  {
   "typ": "Fakt",
   "dokument": "Power BI Update März 2026",
   "dokument_id": "yt:ASwcPvbMRZc",
   "sekunde": 148,
   "zeit": "02:28",
   "url": "https://www.youtube.com/watch?v=ASwcPvbMRZc&t=148s",
   "aussage": "Mit den Custom Totals lässt sich die Gesamtsumme einer Kennzahl (Measure Totals) individuell anders berechnen als die Summe der Einzelzeilen."
  },
  {
   "typ": "Fakt",
   "dokument": "BI Thinkers Talk n.74",
   "dokument_id": "yt:rWE0gMx7v7I",
   "sekunde": 302,
   "zeit": "05:02",
   "url": "https://www.youtube.com/watch?v=rWE0gMx7v7I&t=302s",
   "aussage": "Die neue Karten-Visual-Kachel in Power BI Desktop unterstützt Kreuzfilterung nur, wenn die Kategorienkopfzeile horizontal oben statt seitlich links angeordnet ist."
  },
  {
   "typ": "Fakt",
   "dokument": "Power BI Update März 2026",
   "dokument_id": "yt:ASwcPvbMRZc",
   "sekunde": 337,
   "zeit": "05:37",
   "url": "https://www.youtube.com/watch?v=ASwcPvbMRZc&t=337s",
   "aussage": "Für Zeilenbeschriftungen lassen sich jetzt Führungslinien aktivieren, die bei engem Platz die Zuordnung zu den Werten erleichtern."
  },
  {
   "typ": "Fakt",
   "dokument": "Power BI Update März 2026",
   "dokument_id": "yt:ASwcPvbMRZc",
   "sekunde": 357,
   "zeit": "05:57",
   "url": "https://www.youtube.com/watch?v=ASwcPvbMRZc&t=357s",
   "aussage": "Benutzerdefinierte DAX-Funktionen lassen sich jetzt auch über die grafische Oberfläche anlegen."
  },
  {
   "typ": "Fakt",
   "dokument": "Field Parameter (Feldparameter) in Power BI richtig nutzen - „Werte des ausgewählten Felds anzeigen“",
   "dokument_id": "yt:v8dvnqqa7f8",
   "sekunde": 30,
   "zeit": "00:30",
   "url": "https://www.youtube.com/watch?v=v8dvnqqa7f8&t=30s",
   "aussage": "Ein Feldparameter lässt sich in Power BI Desktop über Modeling und \"Neuer Feldparameter\" anlegen."
  },
  {
   "typ": "Fakt",
   "dokument": "Field Parameter (Feldparameter) in Power BI richtig nutzen - „Werte des ausgewählten Felds anzeigen“",
   "dokument_id": "yt:v8dvnqqa7f8",
   "sekunde": 71,
   "zeit": "01:11",
   "url": "https://www.youtube.com/watch?v=v8dvnqqa7f8&t=71s",
   "aussage": "Power BI erzeugt beim Anlegen eines Feldparameters automatisch eine per DAX erstellte Parametertabelle sowie einen passenden Slicer."
  },
  {
   "typ": "Fakt",
   "dokument": "BI Thinkers Talk n.73",
   "dokument_id": "yt:pOJpXxsfUt0",
   "sekunde": 198,
   "zeit": "03:18",
   "url": "https://www.youtube.com/watch?v=pOJpXxsfUt0&t=198s",
   "aussage": "Field Parameters lassen sich aus einer Datumstabelle mit verschiedenen Ebenen (z. B. Jahr, Monatsname) aufbauen und über die Option \"Single Selection\" als klassischer Werte-Slicer statt als Auswahl-Schalter nutzen."
  },
  {
   "typ": "Warnung",
   "dokument": "BI Thinkers Talk n.73",
   "dokument_id": "yt:pOJpXxsfUt0",
   "sekunde": 689,
   "zeit": "11:29",
   "url": "https://www.youtube.com/watch?v=pOJpXxsfUt0&t=689s",
   "aussage": "Bei einem reinen Flächendiagramm zeigt Power BI im Tooltip vor jedem Feld korrekt einen farbigen Punkt an, während dieselbe Darstellung bei einem kombinierten Line-and-Column-Chart mit zwei Achsen fehlerhaft wird."
  },
  {
   "typ": "Meinung",
   "dokument": "BI Thinkers Talk n.73",
   "dokument_id": "yt:pOJpXxsfUt0",
   "sekunde": 789,
   "zeit": "13:09",
   "url": "https://www.youtube.com/watch?v=pOJpXxsfUt0&t=789s",
   "aussage": "Nach Einschätzung des Sprechers besteht der Tooltip-Fehler bei kombinierten Line-and-Column-Charts mit zwei Achsen bereits seit 2023."
  },
  {
   "typ": "Fakt",
   "dokument": "BI Thinkers Talk n.73",
   "dokument_id": "yt:pOJpXxsfUt0",
   "sekunde": 974,
   "zeit": "16:14",
   "url": "https://www.youtube.com/watch?v=pOJpXxsfUt0&t=974s",
   "aussage": "Zieht man zusätzliche Measures in das Tooltip-Feld eines Visuals, werden weitere Werte im Tooltip angezeigt, das ursprünglich gebundene Measure lässt sich dabei aber nicht aus dem Tooltip entfernen."
  },
  {
   "typ": "Empfehlung",
   "dokument": "BI Thinkers Talk n.73",
   "dokument_id": "yt:pOJpXxsfUt0",
   "sekunde": 974,
   "zeit": "16:14",
   "url": "https://www.youtube.com/watch?v=pOJpXxsfUt0&t=974s",
   "aussage": "Bei komplexen Diagrammen mit unzuverlässigen Standard-Tooltips empfiehlt der Sprecher eine dedizierte Tooltip-Seite, weil generische Lösungen wegen der visual-spezifischen Filterauswahl nicht funktionieren."
  },
  {
   "typ": "Warnung",
   "dokument": "BI Thinkers Talk n.73",
   "dokument_id": "yt:pOJpXxsfUt0",
   "sekunde": 1847,
   "zeit": "30:47",
   "url": "https://www.youtube.com/watch?v=pOJpXxsfUt0&t=1847s",
   "aussage": "Bei zwei redundanten Balken- und Liniendiagrammen mit demselben zugrunde liegenden Feld zeigt Power BI die X-Achsenbeschriftung je nach Diagrammtyp unterschiedlich fett formatiert an, ohne dass dafür ein nachvollziehbarer Grund erkennbar ist."
  },
  {
   "typ": "Fakt",
   "dokument": "BI Thinkers Talk n.73",
   "dokument_id": "yt:pOJpXxsfUt0",
   "sekunde": 2439,
   "zeit": "40:39",
   "url": "https://www.youtube.com/watch?v=pOJpXxsfUt0&t=2439s",
   "aussage": "Eine Monitoring-Analyse zeigte, dass über zwei Drittel der Last auf einem produktiven Direct-Lake-Semantic-Model von Entwicklern in Power BI Desktop stammten und nicht von den eigentlichen Report-Nutzern."
  },
  {
   "typ": "Fakt",
   "dokument": "BI Thinkers Talk n.73",
   "dokument_id": "yt:pOJpXxsfUt0",
   "sekunde": 2913,
   "zeit": "48:33",
   "url": "https://www.youtube.com/watch?v=pOJpXxsfUt0&t=2913s",
   "aussage": "In der Power BI Service Web-Oberfläche gibt es aktuell keine Möglichkeit, die Datenquelle eines Reports direkt umzuhängen; das lässt sich nur nach dem Download im Power BI Desktop ändern."
  },
  {
   "typ": "Fakt",
   "dokument": "Fabric & Power BI Quarterly · 2026-1",
   "dokument_id": "yt:TYp5xCAU2AU",
   "sekunde": 226,
   "zeit": "03:46",
   "url": "https://www.youtube.com/watch?v=TYp5xCAU2AU&t=226s",
   "aussage": "Power BI im Web unterstützt jetzt die Themes-Auswahl und den Performance Analyzer und ist damit fast gleichwertig zu Power BI Desktop."
  },
  {
   "typ": "Fakt",
   "dokument": "Fabric & Power BI Quarterly · 2026-1",
   "dokument_id": "yt:TYp5xCAU2AU",
   "sekunde": 330,
   "zeit": "05:30",
   "url": "https://www.youtube.com/watch?v=TYp5xCAU2AU&t=330s",
   "aussage": "Ab der Februar-Version von Power BI Desktop wird PBIP zur neuen Standardeinstellung beim Speichern von Berichten."
  },
  {
   "typ": "Fakt",
   "dokument": "BI Thinkers Talk nr.71",
   "dokument_id": "yt:LUrL8A5lNgI",
   "sekunde": 1632,
   "zeit": "27:12",
   "url": "https://www.youtube.com/watch?v=LUrL8A5lNgI&t=1632s",
   "aussage": "In Power BI Desktop eingefügte Hyperlinks in Textfeldern lassen sich erst nach der Veröffentlichung des Berichts anklicken, nicht direkt im Desktop."
  },
  {
   "typ": "Fakt",
   "dokument": "BI Thinkers Talk nr.67",
   "dokument_id": "yt:G8s96sHUHac",
   "sekunde": 296,
   "zeit": "04:56",
   "url": "https://www.youtube.com/watch?v=G8s96sHUHac&t=296s",
   "aussage": "Die Visual-Studio-Code-Erweiterung für Microsoft Fabric erlaubt es, aus einer Power-BI-Projektdatei einzelne Teile wie nur den Bericht oder nur das semantische Modell hochzuladen, statt immer die gesamte PBIX hochzuladen."
  },
  {
   "typ": "Fakt",
   "dokument": "BI Thinkers Talk nr.67",
   "dokument_id": "yt:G8s96sHUHac",
   "sekunde": 695,
   "zeit": "11:35",
   "url": "https://www.youtube.com/watch?v=G8s96sHUHac&t=695s",
   "aussage": "Microsoft plant eine Funktion, mit der Power BI Desktop Codeänderungen im Hintergrund automatisch erkennt und die Berichtsdefinition neu lädt, ohne dass die Anwendung komplett neu gestartet werden muss."
  },
  {
   "typ": "Fakt",
   "dokument": "BI Thinkers Talk nr.67",
   "dokument_id": "yt:G8s96sHUHac",
   "sekunde": 791,
   "zeit": "13:11",
   "url": "https://www.youtube.com/watch?v=G8s96sHUHac&t=791s",
   "aussage": "Power BI Desktop wurde so gehärtet, dass es Codesegmente von Drittanbieter-Tools, die es selbst nicht versteht, ignoriert, statt wie früher etwa bei manuellen Partitionsdefinitionen mit einem Fehler abzubrechen."
  },
  {
   "typ": "Warnung",
   "dokument": "BI Thinkers Talk nr.67",
   "dokument_id": "yt:G8s96sHUHac",
   "sekunde": 882,
   "zeit": "14:42",
   "url": "https://www.youtube.com/watch?v=G8s96sHUHac&t=882s",
   "aussage": "Berichte mit Writeback-Visuals wie InfoRiver sollten nach Möglichkeit nicht mehr in Power BI Desktop bearbeitet werden, weil ein erneutes Laden dort bereits von Nutzern eingegebene Daten überschreiben könnte."
  },
  {
   "typ": "Empfehlung",
   "dokument": "BI Thinkers Talk nr.67",
   "dokument_id": "yt:G8s96sHUHac",
   "sekunde": 1263,
   "zeit": "21:03",
   "url": "https://www.youtube.com/watch?v=G8s96sHUHac&t=1263s",
   "aussage": "Ein bestehender Bericht wurde im Live-Connection-Modus aus dem Power-BI-Service heruntergeladen und anschließend über die Datenverbindung von seinem ursprünglichen Importmodell auf ein neu aufgebautes Direct-Lake-Modell mit identischen Measure-Namen umgestellt."
  },
  {
   "typ": "Fakt",
   "dokument": "BI Thinkers Talk nr.67",
   "dokument_id": "yt:G8s96sHUHac",
   "sekunde": 3732,
   "zeit": "1:02:12",
   "url": "https://www.youtube.com/watch?v=G8s96sHUHac&t=3732s",
   "aussage": "Neue wiederverwendbare DAX-Funktionen lassen sich derzeit nicht direkt in der Power-BI-Desktop-Oberfläche erstellen oder bearbeiten, sondern nur im DAX-Abfrageeditor oder über die TMDL-Ansicht, während Desktop sie nur lesend als vorhandene Funktionen mit Lösch- und Umbenennen-Option anzeigt."
  },
  {
