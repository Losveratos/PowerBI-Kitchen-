  "Enum_Minuend_Pl": "PL (Planrechnung)",
  "Numbers_FixedMax": "Skalen-Mindestmaximum (Werte)",
  "Desc_Numbers_FixedMax": "Wertbalken und Wert-Kaskaden reichen mindestens bis zu diesem Betrag — gleiche Skalen über mehrere Visuals (IBCS). Dateneinheiten, k / m / b erlaubt (z. B. 1.5m). Größere Werte erweitern die Skala weiterhin. Leer = automatisch",
  "Ph_Numbers_FixedMax": "z. B. 2m",
  "Numbers_FixedVarMax": "Skalen-Mindestmaximum (Δ)",
  "Desc_Numbers_FixedVarMax": "Dasselbe für Δ-Balken und integrierte Δ-Wasserfälle (symmetrisch ±). Dateneinheiten, k / m / b erlaubt. Leer = automatisch",
  "Ph_Numbers_FixedVarMax": "z. B. 250k",
  "Style_VariancePreset": "Abweichungsfarben-Preset",
  "Desc_Style_VariancePreset": "Blau / Orange ist das ColorBrewer-Paar #2C7BB6 / #E66101 — auch bei vollständiger Farbenblindheit und im Schwarzweiß-Druck unterscheidbar. Auto behält die Abweichungsfarben oben. Die beiden Farbwähler darunter übersteuern weiterhin. Standard: Auto",
  "Enum_VarPreset_Auto": "Wie Abweichungsfarben (Teal / IBCS)",
  "Enum_VarPreset_Teal": "Teal / Rot (farbfehlsicht-tauglich)",
  "Enum_VarPreset_Ibcs": "IBCS Grün / Rot",
  "Enum_VarPreset_BlueOrange": "Blau / Orange (ColorBrewer)",
  "Title_Headline": "Headline-Slot (große Botschaft)",
  "Desc_Title_Headline": "Zeigt die Botschaft als große Headline neben dem Titel (Layout der IBCS-12er-Serie); ohne eigene Botschaft die generierte Auto-Botschaft. Standard: aus",
  "UI_ScaleFixed": "Skala fixiert (nur im Bearbeitungsmodus sichtbar)",
  "UI_ScaleFixedVal": "Werte ≥ {0}",
  "UI_ScaleFixedVar": "Δ ≥ ±{0}",
  "UI_LgBlueOrange": "Dokumentierte IBCS-Abweichung: Blau / Orange statt Grün / Rot (ColorBrewer, auch ohne Farbsehen lesbar).",
  "UI_FooterDevBo": " Dokumentierte Abweichung: Blau / Orange (ColorBrewer) ersetzt das IBCS-Varianz-Grün / -Rot, um ohne Farbsehen und im Schwarzweiß-Druck lesbar zu bleiben.",
  "Role_ColCategory": "Spalten-Kategorie",
  "RoleDesc_ColCategory": "Optional (klassische Tabelle): Der Spaltensatz wiederholt sich je Wert dieses Felds — z. B. je Segment oder Quartal — unter einer Gruppen-Kopfzeile, danach der Gesamt-Block. Der Mega-Table ignoriert das Feld.",
  "Enum_Preset_Custom": "Eigene Auswahl (Schalter darunter)",
  "Enum_EmptyMode_Demo": "Demo-GuV (Smart Start)",
  "Enum_EmptyMode_Fields": "Feld-Intro (welches Feld wohin)",
  "Enum_EmptyMode_Message": "Eigene Nachricht (Titel / Text darunter)",
  "Toolbar_ShowValues": "Gruppe: Wertspalten (Szenarien einzeln)",
  "Desc_Toolbar_ShowValues": "Leser kombinieren die Wertspalten frei — AC, PY, PL, FC und Δ gegen die Δ-Referenz (klassische Tabelle), analysiertes Szenario · PY · PL (Mega-Table). Die Spalten-Presets bleiben als Schnellwahl. Standard: aus",
  "Toolbar_ShowTemplate": "Template-Auswahl im Bearbeitungsmodus",
  "Desc_Toolbar_ShowTemplate": "Kompaktes Template-Dropdown am Anfang der Toolbar, solange du den Bericht bearbeitest (Ansicht Tabelle). Leser und Export sehen es nie. Standard: an",
  "Columns_ColAc": "Eigene Auswahl: Spalte AC",
  "Desc_Columns_ColAc": "Istwerte als Zahlenspalte (mit % vom Umsatz, falls an). Standard: an",
  "Columns_ColPy": "Eigene Auswahl: Spalte PY",
  "Desc_Columns_ColPy": "Vorjahreswerte als Zahlenspalte. Standard: an",
  "Columns_ColPl": "Eigene Auswahl: Spalte PL",
  "Desc_Columns_ColPl": "Planwerte als Zahlenspalte. Standard: an",
  "Columns_ColFc": "Eigene Auswahl: Spalte FC",
  "Desc_Columns_ColFc": "Forecastwerte als Zahlenspalte. Standard: aus",
  "Columns_ColDelta": "Eigene Auswahl: Δ-Balken + Δ%-Pin",
  "Desc_Columns_ColDelta": "Abweichung von AC zur Δ-Referenz als Balken und Pin. Standard: an",
  "Columns_BarOverlap": "Balken-Ansicht: Szenario-Balken überlappt",
  "Desc_Columns_BarOverlap": "AC vorn in voller Stärke, die Referenz (PY grau / PL umrandet / FC schraffiert) dahinter, leicht versetzt — die ChartKitchen-Notation. Standard: aus",
  "Columns_BarTriangles": "Balken-Ansicht: Dreieck-Marker weiterer Szenarien",
  "Desc_Columns_BarTriangles": "Kleine Dreiecke über den Balken am Wert jedes weiteren gebundenen Szenarios (PY grau, PL umrandet, FC schraffiert). Standard: aus",
  "Empty_Mode": "Solange Felder fehlen (Bearbeitungsmodus)",
  "Desc_Empty_Mode": "Start-Hub = große Knöpfe für Feature-Tour, Template-Galerie, Demo und Feld-Intro · Demo = Beispiel-GuV (Smart Start) · Feld-Intro = welches Feld wohin, minimal und im Ausbau · Eigene Nachricht = Titel und Text darunter. Leser sehen immer den Standardtext oder die eigene Nachricht. Standard: Start-Hub",
  "UI_TbValues": "Wertspalten",
