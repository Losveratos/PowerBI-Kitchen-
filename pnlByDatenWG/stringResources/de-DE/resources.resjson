  "Desc_Labels_RenamePy": "Eigener Begriff für PY, auch in den ΔPY-Köpfen (z. B. „Vorjahr“). Leer = PY",
  "Desc_Labels_RenamePl": "Eigener Begriff für PL, auch in den ΔPL-Köpfen (z. B. „Budget“). Leer = PL",
  "Desc_Labels_RenameFc": "Eigener Begriff für FC (z. B. „Prognose“). Leer = FC",
