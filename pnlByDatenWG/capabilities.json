{
    "privileges": [],
    "dataRoles": [
        {
            "name": "account",
            "displayName": "Account ID (key)",
            "displayNameKey": "Role_Account",
            "kind": "Grouping",
            "description": "Unique, stable account key from the account dimension"
        },
        {
            "name": "accountName",
            "displayName": "Account name",
            "displayNameKey": "Role_AccountName",
            "kind": "Grouping"
        },
        {
            "name": "levels",
            "displayName": "Level columns (L1..Ln)",
            "displayNameKey": "Role_Levels",
            "kind": "Grouping",
            "description": "Star-schema alternative to Parent ID: flattened hierarchy levels in drag order. Ragged branches end at an empty level or when a level repeats the previous one."
        },
        {
            "name": "parent",
            "displayName": "Parent account ID",
            "displayNameKey": "Role_Parent",
            "kind": "Grouping",
            "description": "Parent-child link; unbalanced hierarchies are allowed"
        },
        {
            "name": "sortOrder",
            "displayName": "Sort order",
            "displayNameKey": "Role_SortOrder",
            "kind": "Grouping"
        },
        {
            "name": "rowType",
            "displayName": "Row type",
            "displayNameKey": "Role_RowType",
            "kind": "Grouping",
            "description": "Account | Subtotal | Formula | KPI | Separator"
        },
        {
            "name": "formulaDef",
            "displayName": "Formula definition",
            "displayNameKey": "Role_FormulaDef",
            "kind": "Grouping",
            "description": "For Formula/KPI rows, e.g. [EBITDA]/[Revenue]"
        },
        {
            "name": "signConvention",
            "displayName": "Sign convention (±1)",
            "displayNameKey": "Role_Sign",
            "kind": "Grouping",
            "description": "Calculation sign: revenue +1, costs -1"
        },
        {
            "name": "displayInvert",
            "displayName": "Display invert",
            "displayNameKey": "Role_DisplayInvert",
            "kind": "Grouping",
            "description": "Show positive although the calculated value is negative"
        },
        {
            "name": "varianceInvert",
            "displayName": "Variance invert",
            "displayNameKey": "Role_VarianceInvert",
            "kind": "Grouping",
            "description": "Flip variance color (costs below plan = green)"
        },
        {
            "name": "period",
            "displayName": "Period (month)",
            "displayNameKey": "Role_Period",
            "kind": "Grouping",
            "description": "Month column for sparklines and YTD aggregation; values are summed across the shown periods. Date keys (YYYY-MM, YYYY-MM-DD), date columns and month names (Dez, Dezember, Dec, March, Mär …) are read into calendar order automatically — see Columns → Period sort order for fiscal years"
        },
        {
            "name": "comment",
            "displayName": "Comment",
            "displayNameKey": "Role_Comment",
            "kind": "Grouping",
            "description": "Comment text per row — shown as numbered marker with a footnote section"
        },
        {
            "name": "ac",
            "displayName": "AC (Actual)",
            "displayNameKey": "Role_AC",
            "kind": "Measure"
        },
        {
            "name": "py",
            "displayName": "PY (Previous Year)",
            "displayNameKey": "Role_PY",
            "kind": "Measure"
        },
        {
            "name": "pl",
            "displayName": "PL (Plan / Budget)",
            "displayNameKey": "Role_PL",
            "kind": "Measure"
        },
        {
            "name": "fc",
            "displayName": "FC (Forecast)",
            "displayNameKey": "Role_FC",
            "kind": "Measure"
        },
        {
            "name": "fcFy",
            "displayName": "FC Full Year (outlook)",
            "displayNameKey": "Role_FCFY",
            "kind": "Measure",
            "description": "Full-year forecast scalar (repeated per month row; first value wins, never summed)"
        },
        {
            "name": "plFy",
            "displayName": "PL Full Year",
            "displayNameKey": "Role_PLFY",
            "kind": "Measure",
            "description": "Full-year plan scalar for the outlook block"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "account": {
                        "max": 1
                    },
                    "accountName": {
                        "max": 1
                    },
                    "levels": {
                        "max": 8
                    },
                    "parent": {
                        "max": 1
                    },
                    "sortOrder": {
                        "max": 1
                    },
                    "rowType": {
                        "max": 1
                    },
                    "formulaDef": {
                        "max": 1
                    },
                    "signConvention": {
                        "max": 1
                    },
                    "displayInvert": {
                        "max": 1
                    },
                    "varianceInvert": {
                        "max": 1
                    },
                    "ac": {
                        "max": 1
                    },
                    "py": {
                        "max": 1
                    },
                    "pl": {
                        "max": 1
                    },
                    "fc": {
                        "max": 1
                    },
                    "period": {
                        "max": 1
                    },
                    "comment": {
                        "max": 1
                    },
                    "fcFy": {
                        "max": 1
                    },
                    "plFy": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "select": [
                        {
                            "for": {
                                "in": "account"
                            }
                        },
                        {
                            "for": {
                                "in": "accountName"
                            }
                        },
                        {
                            "for": {
                                "in": "levels"
                            }
                        },
                        {
                            "for": {
                                "in": "parent"
                            }
                        },
                        {
                            "for": {
                                "in": "sortOrder"
                            }
                        },
                        {
                            "for": {
                                "in": "rowType"
                            }
                        },
                        {
                            "for": {
                                "in": "formulaDef"
                            }
                        },
                        {
                            "for": {
                                "in": "signConvention"
                            }
                        },
                        {
                            "for": {
                                "in": "displayInvert"
                            }
                        },
                        {
                            "for": {
                                "in": "varianceInvert"
                            }
                        },
                        {
                            "for": {
                                "in": "period"
                            }
                        },
                        {
                            "for": {
                                "in": "comment"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "window": {
                            "count": 30000
                        }
                    }
                },
                "values": {
                    "select": [
                        {
                            "bind": {
                                "to": "ac"
                            }
                        },
                        {
                            "bind": {
                                "to": "py"
                            }
                        },
                        {
                            "bind": {
                                "to": "pl"
                            }
                        },
                        {
                            "bind": {
                                "to": "fc"
                            }
                        },
                        {
                            "bind": {
                                "to": "fcFy"
                            }
                        },
                        {
                            "bind": {
                                "to": "plFy"
                            }
                        }
                    ]
                }
            }
        }
    ],
