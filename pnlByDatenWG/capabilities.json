{
    "privileges": [],
    "dataRoles": [
        {
            "name": "levels",
            "displayName": "Level columns (L1..Ln)",
            "displayNameKey": "Role_Levels",
            "kind": "Grouping",
            "description": "Star-schema alternative to Parent ID: flattened hierarchy levels in drag order. Ragged branches end at an empty level or when a level repeats the previous one.",
            "descriptionKey": "RoleDesc_Levels"
        },
        {
            "name": "account",
            "displayName": "Account ID (key)",
            "displayNameKey": "Role_Account",
            "kind": "Grouping",
            "description": "Unique, stable account key from the account dimension — basis of the parent-child hierarchy and of the selection.",
            "descriptionKey": "RoleDesc_Account"
        },
        {
            "name": "accountName",
            "displayName": "Account name",
            "displayNameKey": "Role_AccountName",
            "kind": "Grouping",
            "description": "Display name of the row; without it the visual shows the account ID.",
            "descriptionKey": "RoleDesc_AccountName"
        },
        {
            "name": "parent",
            "displayName": "Parent account ID",
            "displayNameKey": "Role_Parent",
            "kind": "Grouping",
            "description": "Parent-child link; unbalanced hierarchies are allowed.",
            "descriptionKey": "RoleDesc_Parent"
        },
        {
            "name": "ac",
            "displayName": "AC (Actual)",
            "displayNameKey": "Role_AC",
            "kind": "Measure",
            "description": "Actual (AC) value — the primary measure. Required.",
            "descriptionKey": "RoleDesc_AC"
        },
        {
            "name": "py",
            "displayName": "PY (Previous Year)",
            "displayNameKey": "Role_PY",
            "kind": "Measure",
            "description": "Previous-year (PY) value — basis of ΔPY.",
            "descriptionKey": "RoleDesc_PY"
        },
        {
            "name": "pl",
            "displayName": "PL (Plan / Budget)",
            "displayNameKey": "Role_PL",
            "kind": "Measure",
            "description": "Plan / budget (PL) value — basis of ΔPL, drawn outlined (IBCS).",
            "descriptionKey": "RoleDesc_PL"
        },
        {
            "name": "fc",
            "displayName": "FC (Forecast)",
            "displayNameKey": "Role_FC",
            "kind": "Measure",
            "description": "Forecast (FC) value, drawn hatched; can be the analysed scenario of the mega table.",
            "descriptionKey": "RoleDesc_FC"
        },
        {
            "name": "period",
            "displayName": "Period (month)",
            "displayNameKey": "Role_Period",
            "kind": "Grouping",
            "description": "Month column for sparklines, the month and the YTD block; values are summed across the shown periods. Date keys (YYYY-MM, YYYY-MM-DD), date columns and month names are read into calendar order automatically — see Columns → Period sort order for fiscal years.",
            "descriptionKey": "RoleDesc_Period"
        },
        {
            "name": "colCategory",
            "displayName": "Column category",
            "displayNameKey": "Role_ColCategory",
            "kind": "Grouping",
            "description": "Optional (classic table): the column set repeats once per value of this field — e.g. per segment or per quarter — under a group header, with the total block after it. Ignored by the mega table.",
            "descriptionKey": "RoleDesc_ColCategory"
        },
        {
            "name": "rowType",
            "displayName": "Row type",
            "displayNameKey": "Role_RowType",
            "kind": "Grouping",
            "description": "Account | Subtotal | Formula | KPI | Separator — drives totals, formulas and margin rows.",
            "descriptionKey": "RoleDesc_RowType"
        },
        {
            "name": "formulaDef",
            "displayName": "Formula definition",
            "displayNameKey": "Role_FormulaDef",
            "kind": "Grouping",
            "description": "For Formula/KPI rows, e.g. [EBITDA]/[Revenue].",
            "descriptionKey": "RoleDesc_FormulaDef"
        },
        {
            "name": "signConvention",
            "displayName": "Sign convention (±1)",
            "displayNameKey": "Role_Sign",
            "kind": "Grouping",
            "description": "Calculation sign: revenue +1, costs −1.",
            "descriptionKey": "RoleDesc_Sign"
        },
        {
            "name": "displayInvert",
            "displayName": "Display invert",
            "displayNameKey": "Role_DisplayInvert",
            "kind": "Grouping",
            "description": "Show positive although the calculated value is negative (cost rows).",
            "descriptionKey": "RoleDesc_DisplayInvert"
        },
        {
            "name": "varianceInvert",
            "displayName": "Variance invert",
            "displayNameKey": "Role_VarianceInvert",
            "kind": "Grouping",
            "description": "Flip the variance color (costs below plan = favorable).",
            "descriptionKey": "RoleDesc_VarianceInvert"
        },
        {
            "name": "sortOrder",
            "displayName": "Sort order",
            "displayNameKey": "Role_SortOrder",
            "kind": "Grouping",
            "description": "Number per row that fixes the P&L order (e.g. 10, 20, 30).",
            "descriptionKey": "RoleDesc_SortOrder"
        },
        {
            "name": "comment",
            "displayName": "Comment",
            "displayNameKey": "Role_Comment",
            "kind": "Grouping",
            "description": "Comment text per row — shown as a numbered marker with a footnote section.",
            "descriptionKey": "RoleDesc_Comment"
        },
        {
            "name": "filterInfo",
            "displayName": "Filter info (footer)",
            "displayNameKey": "Role_FilterInfo",
            "kind": "Measure",
            "requiredTypes": [ { "text": true } ],
            "description": "Text measure carrying the current filter context (e.g. via CONCATENATEX/SELECTEDVALUE) — shown as a second footer line when the filter footer is enabled.",
            "descriptionKey": "RoleDesc_FilterInfo"
        },
        {
            "name": "fcFy",
            "displayName": "FC Full Year (outlook)",
            "displayNameKey": "Role_FCFY",
            "kind": "Measure",
            "description": "Full-year forecast scalar (repeated per month row; first value wins, never summed).",
            "descriptionKey": "RoleDesc_FCFY"
        },
        {
            "name": "plFy",
            "displayName": "PL Full Year",
            "displayNameKey": "Role_PLFY",
            "kind": "Measure",
            "description": "Full-year plan scalar for the outlook block.",
            "descriptionKey": "RoleDesc_PLFY"
        }
    ],
