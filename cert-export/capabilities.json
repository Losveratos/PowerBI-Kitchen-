{
    "dataRoles": [
        {
            "displayName": "Category",
            "description": "Axis or structure field — supports multiple columns for drill-down and a table row tree. Dates render automatically as \"Mar 26\". Optional since 1.41: leave it empty and the visual renders a single KPI tile/column labeled with the actual measure's name.",
            "descriptionKey": "RoleDesc_Category",
            "displayNameKey": "Role_Category",
            "name": "category",
            "kind": "Grouping"
        },
        {
            "displayName": "Actual (AC)",
            "description": "Actual (AC) value — the primary measure. Required unless a forecast measure is bound instead.",
            "descriptionKey": "RoleDesc_Actual",
            "displayNameKey": "Role_Actual",
            "name": "actual",
            "kind": "Measure",
            "requiredTypes": [ { "numeric": true }, { "integer": true } ]
        },
        {
            "displayName": "Previous Year (PY)",
            "description": "Previous year (PY) value, used as one of the variance comparison bases (ΔPY).",
            "descriptionKey": "RoleDesc_PreviousYear",
            "displayNameKey": "Role_PreviousYear",
            "name": "previousYear",
            "kind": "Measure",
            "requiredTypes": [ { "numeric": true }, { "integer": true } ]
        },
        {
            "displayName": "Plan / Budget (PL)",
            "description": "Plan/Budget measure. Rendered as outlined columns (IBCS notation) and used as the ΔPL variance basis.",
            "descriptionKey": "RoleDesc_Plan",
            "displayNameKey": "Role_Plan",
            "name": "plan",
            "kind": "Measure",
            "requiredTypes": [ { "numeric": true }, { "integer": true } ]
        },
        {
            "displayName": "Forecast (FC)",
            "description": "Forecast (FC) value, shown hatched. Displayed only where actual is missing — unless chart.acFcSplit is set to full/rest, which renders a split column (AC base + FC top).",
            "descriptionKey": "RoleDesc_Forecast",
            "displayNameKey": "Role_Forecast",
            "name": "forecast",
            "kind": "Measure",
            "requiredTypes": [ { "numeric": true }, { "integer": true } ]
        },
        {
            "displayName": "Benchmark (BM)",
            "description": "Benchmark (BM) value per category — shown as a dash marker on charts and as a bullet indicator on KPI cards.",
            "descriptionKey": "RoleDesc_Benchmark",
            "displayNameKey": "Role_Benchmark",
            "name": "benchmark",
            "kind": "Measure",
            "requiredTypes": [ { "numeric": true }, { "integer": true } ]
        },
        {
            "displayName": "FC Vormonat (Revision)",
            "description": "Forecast from the previous cycle. Enables the \"fcrev\" variance basis (ΔFC vs. last forecast) to show what shifted since the prior forecast.",
            "descriptionKey": "RoleDesc_PrevForecast",
            "displayNameKey": "Role_PrevForecast",
            "name": "prevForecast",
            "kind": "Measure",
            "requiredTypes": [ { "numeric": true }, { "integer": true } ]
        },
        {
            "displayName": "Line (Kombi)",
            "description": "Second measure drawn as a combo line over the columns on its own right-hand scale (e.g. margin %). Available only in columns orientation.",
            "descriptionKey": "RoleDesc_LineMeasure",
            "displayNameKey": "Role_LineMeasure",
            "name": "lineMeasure",
            "kind": "Measure",
            "requiredTypes": [ { "numeric": true }, { "integer": true } ]
        },
        {
            "displayName": "Stack Series (Gestapelt)",
            "description": "Splits Actual by an additional dimension and stacks the columns/bars by that series, with legend and stack-total labels.",
            "descriptionKey": "RoleDesc_Series",
            "displayNameKey": "Role_Series",
            "name": "series",
            "kind": "Grouping"
        },
        {
            "displayName": "Spalten (Matrix)",
            "description": "Table/matrix only: pivots the values into column groups (e.g. quarter → month, max. 2 levels), turning the plain table into a matrix with a collapsible column hierarchy.",
            "descriptionKey": "RoleDesc_ColGroup",
            "displayNameKey": "Role_ColGroup",
            "name": "colgroup",
            "kind": "Grouping"
        },
        {
            "displayName": "Filter-Info (Fußzeile)",
            "description": "Text measure carrying the current filter context (e.g. via CONCATENATEX/SELECTEDVALUE) — shown as a second footer line when the filter footer is enabled.",
            "descriptionKey": "RoleDesc_FilterInfo",
            "displayNameKey": "Role_FilterInfo",
            "name": "filterInfo",
            "kind": "Measure",
            "requiredTypes": [ { "text": true } ]
        },
        {
            "displayName": "Comments",
            "description": "Text measure — categories with a comment get a numbered marker (①②…) and the text appears in the footnote panel.",
            "descriptionKey": "RoleDesc_Comments",
            "displayNameKey": "Role_Comments",
            "name": "comments",
            "kind": "Measure"
        },
        {
            "displayName": "Small Multiples",
            "description": "Splits the chart into small-multiple tiles per group, all sharing the same scale (IBCS small multiples).",
            "descriptionKey": "RoleDesc_Multiples",
            "displayNameKey": "Role_Multiples",
            "name": "multiples",
            "kind": "Grouping"
        },
        {
            "displayName": "Waterfall Type (sum/delta)",
            "description": "Waterfall/P&L only: \"sum\" marks a subtotal/anchor row, \"delta\" a movement row, \"pct\" a margin row (shown as %, with variance in percentage points).",
            "descriptionKey": "RoleDesc_RowType",
            "displayNameKey": "Role_RowType",
            "name": "rowType",
            "kind": "Grouping"
        },
        {
            "displayName": "Forecast Flag (1/0)",
            "description": "Alternative to a separate FC measure: 1/true marks the AC value as forecast (hatched); 2 or \"prelim\" marks it as preliminary actual (solid bar with thin overlay hatching); 0/blank means a normal actual.",
            "descriptionKey": "RoleDesc_FcFlag",
            "displayNameKey": "Role_FcFlag",
            "name": "fcFlag",
            "kind": "Grouping"
        }
    ],
    "objects": {
        "ibcsTitle": {
            "properties": {
                "show": { "type": { "bool": true } },
                "kpi": { "type": { "text": true } },
                "period": { "type": { "text": true } },
                "message": { "type": { "text": true } },
                "autoMessage": { "type": { "bool": true } },
                "footer": { "type": { "text": true } },
                "filterFooter": { "type": { "bool": true } }
            }
        },
        "chart": {
            "properties": {
                "orientation": {
                    "type": {
                        "enumeration": [
                            { "value": "columns", "displayName": "Columns (Zeit)" },
                            { "value": "bars", "displayName": "Bars (Struktur)" },
                            { "value": "line", "displayName": "Line (Zeit, viele Punkte)" },
                            { "value": "waterfall", "displayName": "Waterfall / Brücke" },
                            { "value": "intwaterfall", "displayName": "Integrierte Brücke (Zeit)" },
                            { "value": "catbridge", "displayName": "Kategorie-Brücke (Struktur)" },
                            { "value": "table", "displayName": "Tabelle (IBCS)" },
                            { "value": "pareto", "displayName": "Pareto (Struktur)" },
                            { "value": "dumbbell", "displayName": "Dumbbell (Struktur)" },
                            { "value": "slope", "displayName": "Slope · Vorher/Nachher" },
                            { "value": "cards", "displayName": "KPI-Karten (Kacheln)" },
                            { "value": "pnl", "displayName": "GuV-Statement (IBCS)" }
                        ]
                    }
                },
                "smartStart": { "type": { "bool": true } },
                "smartStartDismissed": { "type": { "text": true } },
                "pnlView": { "type": { "text": true } },
                "tableExpanded": { "type": { "text": true } },
                "tableSort": { "type": { "text": true } },
                "tableColExpanded": { "type": { "text": true } },
                "valueColumns": {
                    "type": {
                        "enumeration": [
                            { "value": "ac", "displayName": "AC only" },
                            { "value": "basis", "displayName": "AC + variance basis" },
                            { "value": "all", "displayName": "AC · PY · PL" }
                        ]
                    }
                },
                "structureEdit": { "type": { "bool": true } },
                "resultList": { "type": { "text": true } },
                "skipList": { "type": { "text": true } },
                "hideList": { "type": { "text": true } },
                "chartList": { "type": { "text": true } },
                "indentList": { "type": { "text": true } },
                "rowFormats": { "type": { "text": true } },
                "tableNameWidth": { "type": { "text": true } },
                "matrixCompare": {
                    "type": {
                        "enumeration": [
                            { "value": "none", "displayName": "Off" },
                            { "value": "prevcol", "displayName": "Δ vs. previous column" }
                        ]
                    }
                },
                "formulaRows": { "type": { "text": true } },
                "totalRowPosition": {
                    "type": {
                        "enumeration": [
                            { "value": "bottom", "displayName": "Bottom (below rows)" },
                            { "value": "top", "displayName": "Top (below header)" }
                        ]
                    }
                },
                "zebraStripes": { "type": { "bool": true } },
                "acFcSplit": {
                    "type": {
                        "enumeration": [
                            { "value": "off", "displayName": "Off (FC only where AC is missing)" },
                            { "value": "full", "displayName": "FC = full-month outlook (top-up)" },
                            { "value": "rest", "displayName": "FC = rest of month (additive)" }
                        ]
                    }
                },
                "hideBlankCat": { "type": { "bool": true } },
                "exportExpandAll": { "type": { "bool": true } },
                "rowDensity": {
                    "type": {
                        "enumeration": [
                            { "value": "compact", "displayName": "Compact" },
                            { "value": "normal", "displayName": "Normal" },
                            { "value": "airy", "displayName": "Airy" }
                        ]
                    }
                },
                "gridLines": {
                    "type": {
                        "enumeration": [
                            { "value": "horizontal", "displayName": "Horizontal" },
                            { "value": "none", "displayName": "None" },
                            { "value": "both", "displayName": "Horizontal + vertical" }
                        ]
                    }
                },
                "cellLayout": {
                    "type": {
                        "enumeration": [
                            { "value": "columns", "displayName": "Columns (value · Δ side by side)" },
                            { "value": "stacked", "displayName": "Two rows: value on top, Δ below" }
                        ]
                    }
                },
                "tableColWidths": { "type": { "text": true } },
                "cardStatusBasis": {
                    "type": {
                        "enumeration": [
                            { "value": "basis", "displayName": "Variance basis" },
                            { "value": "benchmark", "displayName": "Benchmark (BM)" }
                        ]
                    }
                },
                "cardHighlight": {
                    "type": {
                        "enumeration": [
                            { "value": "both", "displayName": "Good & bad" },
                            { "value": "bad", "displayName": "Only bad" },
                            { "value": "good", "displayName": "Only good" }
                        ]
                    }
                },
                "cardBars": { "type": { "bool": true } },
                "cardRefValues": {
                    "type": {
                        "enumeration": [
                            { "value": "off", "displayName": "Only variances" },
                            { "value": "basis", "displayName": "Basis value" },
                            { "value": "all", "displayName": "All bound scenarios" }
                        ]
                    }
                },
                "cardSort": {
                    "type": {
                        "enumeration": [
                            { "value": "none", "displayName": "Data order" },
                            { "value": "deviation", "displayName": "Biggest deviation first" },
                            { "value": "worst", "displayName": "Worst first" },
                            { "value": "best", "displayName": "Best first" }
                        ]
                    }
                },
                "pinStyle": {
                    "type": {
                        "enumeration": [
                            { "value": "auto", "displayName": "Automatic (per mode)" },
                            { "value": "round", "displayName": "Round" },
                            { "value": "square", "displayName": "Square" }
                        ]
                    }
                },
                "deltaIcons": { "type": { "bool": true } },
                "cardSortSel": { "type": { "text": true } },
                "cardTint": { "type": { "bool": true } },
                "cardTintStrength": { "type": { "numeric": true } },
                "cardBullet": { "type": { "bool": true } },
                "cardBulletZoom": { "type": { "bool": true } },
                "comparisonMode": {
                    "type": {
                        "enumeration": [
                            { "value": "auto", "displayName": "Auto" },
                            { "value": "py", "displayName": "Previous Year (PY)" },
                            { "value": "plan", "displayName": "Plan (PL)" },
                            { "value": "fcrev", "displayName": "FC Vormonat (Revision)" }
                        ]
                    }
                },
                "showAbsoluteVariance": { "type": { "bool": true } },
                "showRelativeVariance": { "type": { "bool": true } },
                "showTotal": { "type": { "bool": true } },
                "topN": { "type": { "numeric": true } },
                "movingAverage": { "type": { "numeric": true } },
                "dualVariance": { "type": { "bool": true } },
                "pyTriangle": { "type": { "bool": true } },
                "cumulative": { "type": { "bool": true } },
                "cumulativeKind": {
                    "type": {
                        "enumeration": [
                            { "value": "ytd", "displayName": "YTD" },
                            { "value": "qtd", "displayName": "QTD" },
                            { "value": "r12", "displayName": "R12" }
                        ]
                    }
                },
                "fiscalStart": { "type": { "numeric": true } },
                "cumulativeButton": { "type": { "bool": true } },
                "materialityAbs": { "type": { "numeric": true } },
                "materialityPct": { "type": { "numeric": true } },
                "exceptionOnly": { "type": { "bool": true } },
                "highlight": { "type": { "text": true } },
                "groupEvery": { "type": { "numeric": true } },
                "multiplesTotal": { "type": { "bool": true } },
                "multiplesTopN": { "type": { "numeric": true } },
                "multiplesHero": { "type": { "bool": true } },
                "multiplesSameScale": { "type": { "bool": true } },
                "waterfallStyle": { "type": { "bool": true } },
                "sortByImpact": { "type": { "bool": true } },
                "chartButtons": { "type": { "bool": true } },
                "driverNote": { "type": { "bool": true } },
                "compareClick": { "type": { "bool": true } },
                "invert": { "type": { "bool": true } },
                "invertList": { "type": { "text": true } }
            }
        },
        "colors": {
            "properties": {
                "variancePreset": {
                    "type": {
                        "enumeration": [
                            { "value": "custom", "displayName": "Farbwähler unten (Teal/Rot)" },
                            { "value": "blueOrange", "displayName": "Blau/Orange (ColorBrewer)" }
                        ]
                    }
                },
                "useTheme": { "type": { "bool": true } },
                "actualColor": { "type": { "fill": { "solid": { "color": true } } } },
                "previousYearColor": { "type": { "fill": { "solid": { "color": true } } } },
                "planColor": { "type": { "fill": { "solid": { "color": true } } } },
                "goodColor": { "type": { "fill": { "solid": { "color": true } } } },
                "badColor": { "type": { "fill": { "solid": { "color": true } } } }
            }
        },
        "labels": {
            "properties": {
                "show": { "type": { "bool": true } },
                "sumSafeRounding": { "type": { "bool": true } },
                "financeFormat": { "type": { "bool": true } },
                "labelAc": { "type": { "text": true } },
                "labelPy": { "type": { "text": true } },
                "labelPl": { "type": { "text": true } },
                "labelFc": { "type": { "text": true } },
                "labelDensity": {
                    "type": {
                        "enumeration": [
                            { "value": "auto", "displayName": "Automatic (thin out)" },
                            { "value": "all", "displayName": "All" },
                            { "value": "ends", "displayName": "First / last / extremes" }
                        ]
                    }
                },
                "fontScale": { "type": { "numeric": true } },
                "fontPreset": {
                    "type": {
                        "enumeration": [
                            { "value": "compact", "displayName": "Kompakt (Dashboard-Kachel)" },
                            { "value": "fullhd", "displayName": "Full HD (1080p)" },
                            { "value": "presentation", "displayName": "Präsentation (4K / Beamer)" }
                        ]
                    }
                },
                "fontSize": { "type": { "formatting": { "fontSize": true } } },
                "decimals": { "type": { "numeric": true } },
                "displayUnits": {
                    "type": {
                        "enumeration": [
                            { "value": "auto", "displayName": "Auto" },
                            { "value": "none", "displayName": "None" },
                            { "value": "k", "displayName": "Thousands (k)" },
                            { "value": "m", "displayName": "Millions (M)" },
                            { "value": "b", "displayName": "Billions (B)" }
                        ]
                    }
                }
            }
        },
        "commentsPanel": {
            "properties": {
                "showPanel": { "type": { "bool": true } },
                "commentFontSize": { "type": { "numeric": true } },
                "editComments": { "type": { "bool": true } },
                "userComments": { "type": { "text": true } }
            }
        },
        "scale": {
            "properties": {
                "fixedMax": { "type": { "numeric": true } },
                "fixedVarMax": { "type": { "numeric": true } },
                "capOverflow": { "type": { "bool": true } },
                "refLine": { "type": { "text": true } },
                "refLineLabel": { "type": { "text": true } }
            }
        },
        "categoryAxis": {
            "properties": {
                "fontSize": { "type": { "formatting": { "fontSize": true } } }
            }
        }
    },
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "category": { "max": 1 },
                    "multiples": { "max": 1 },
                    "series": { "max": 1 },
                    "lineMeasure": { "max": 1 },
                    "rowType": { "max": 1 },
                    "fcFlag": { "max": 1 },
                    "actual": { "max": 1 },
                    "previousYear": { "max": 1 },
                    "plan": { "max": 1 },
                    "forecast": { "max": 1 },
                    "prevForecast": { "max": 1 },
                    "benchmark": { "max": 1 },
                    "comments": { "max": 1 },
                    "filterInfo": { "max": 1 },
                    "colgroup": { "max": 2 }
                }
            ],
            "categorical": {
                "categories": {
                    "select": [
                        { "for": { "in": "category" } },
                        { "for": { "in": "multiples" } },
                        { "for": { "in": "series" } },
                        { "for": { "in": "rowType" } },
                        { "for": { "in": "fcFlag" } },
                        { "for": { "in": "colgroup" } }
                    ],
                    "dataReductionAlgorithm": { "top": { "count": 1000 } }
                },
                "values": {
                    "select": [
                        { "bind": { "to": "actual" } },
                        { "bind": { "to": "previousYear" } },
                        { "bind": { "to": "plan" } },
                        { "bind": { "to": "forecast" } },
                        { "bind": { "to": "prevForecast" } },
                        { "bind": { "to": "benchmark" } },
                        { "bind": { "to": "lineMeasure" } },
                        { "bind": { "to": "comments" } },
                        { "bind": { "to": "filterInfo" } }
                    ]
                }
            }
        }
    ],
    "sorting": {
        "default": {}
    },
    "drilldown": {
        "roles": [ "category" ]
    },
    "tooltips": {
        "supportedTypes": {
            "default": true,
            "canvas": true
        }
    },
    "supportsHighlight": true,
    "supportsKeyboardFocus": true,
    "supportsMultiVisualSelection": true,
    "supportsLandingPage": true,
    "supportsEmptyDataView": true,
    "privileges": []
}
