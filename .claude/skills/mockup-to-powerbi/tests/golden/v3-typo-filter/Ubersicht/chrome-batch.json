        "border.show": true,
        "border.color": "#E5E7EB",
        "border.width": 1,
        "dropShadow.show": false,
        "border.radius": 6,
        "title.fontSize": 16,
        "subTitle.fontSize": 12.5,
        "position.z": 10
      },
      "continue_on_error": true
    },
    {
      "id": "format-12",
      "op": "set",
      "select": "Übersicht.Page/mk_col1.Visual",
      "set": {
        "background.show": true,
        "background.color": "#FFFFFF",
        "background.transparency": 0,
        "border.show": true,
        "border.color": "#E5E7EB",
        "border.width": 1,
        "dropShadow.show": false,
        "border.radius": 6,
        "title.fontSize": 21,
        "subTitle.fontSize": 16,
        "position.z": 10
      },
      "continue_on_error": true
    },
    {
      "id": "format-13",
      "op": "set",
      "select": "Übersicht.Page/mk_kpi1.Visual",
      "set": {
        "background.show": true,
        "background.color": "#FFFFFF",
        "background.transparency": 0,
        "border.show": true,
        "border.color": "#E5E7EB",
        "border.width": 1,
        "dropShadow.show": false,
        "border.radius": 6,
        "title.fontSize": 16,
        "subTitle.fontSize": 12.5,
        "position.z": 10
      },
      "continue_on_error": true
    },
    {
      "id": "format-14",
      "op": "set",
      "select": "Übersicht.Page/mk_slicer_Date_p1.Visual",
      "set": {
        "data.mode": "Between",
        "position.z": 10
      },
      "continue_on_error": true
    },
    {
      "id": "format-15",
      "op": "set",
      "select": "Übersicht.Page/mk_slicer_Region_p1.Visual",
      "set": {
        "data.mode": "Basic",
        "general.orientation": 1,
        "position.z": 10
      },
      "continue_on_error": true
    },
    {
      "id": "format-16",
      "op": "set",
      "select": "Übersicht.Page/mk_slicer_Year_p1.Visual",
      "set": {
        "data.mode": "Dropdown",
        "position.z": 10
      },
      "continue_on_error": true
    },
