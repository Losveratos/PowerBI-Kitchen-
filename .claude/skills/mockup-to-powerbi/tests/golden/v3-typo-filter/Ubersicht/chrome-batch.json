      "id": "format-17",
      "op": "set",
      "select": "Übersicht.Page/mk_txt1.Visual",
      "set": {
        "fill.show": false,
        "outline.show": false,
        "text.text": "Die Regionen sind nach Umsatz sortiert.",
        "text.fontSize": 16,
        "text.fontColor": "#0F1E2E",
        "text.horizontalAlignment": "left",
        "text.verticalAlignment": "top",
        "background.show": true,
        "background.color": "#FFFFFF",
        "background.transparency": 0,
        "border.show": true,
        "border.color": "#E5E7EB",
        "border.width": 1,
        "dropShadow.show": false,
        "border.radius": 6,
        "position.z": 10
