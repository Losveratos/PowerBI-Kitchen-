        "text.text": "Alle Werte in Tsd. EUR. Stand: Vormonat.",
        "text.fontSize": 14.5,
        "text.fontColor": "#6B7280",
        "text.horizontalAlignment": "left",
        "text.verticalAlignment": "top",
        "position.z": 4
      },
      "continue_on_error": true
    },
    {
      "id": "format-3",
      "op": "set",
      "select": "Übersicht.Page/chrome_filter_title.Visual",
      "set": {
