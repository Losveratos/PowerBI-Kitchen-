{
  "version": 2,
  "name": "mockup · Übersicht",
  "root": "Test.Report",
  "stop_on_error": false,
  "steps": [
    {
      "id": "format",
      "op": "set",
      "select": "Übersicht.Page/chrome_filter_bg.Visual",
      "set": {
        "shape.tileShape": "rectangle",
        "fill.show": true,
        "fill.fillColor": "#F1F3F5",
        "outline.show": false,
        "position.z": 0
      },
      "continue_on_error": true
    },
    {
      "id": "format-2",
      "op": "set",
      "select": "Übersicht.Page/chrome_filter_text.Visual",
      "set": {
